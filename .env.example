# Copy to .env and fill in. Vite reads VITE_ prefixed variables at build time.
#
# Required. src/lib/supabase.ts throws at import without both, which also fails
# four test files, so the test suite needs them set. Any non empty value works
# for `npm test`; the real project values are needed for `npm run dev`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Sentry is a no op when the DSN is unset.
VITE_SENTRY_DSN=

# Optional. GolfCourseAPI course search is hidden when unset.
VITE_GOLF_COURSE_API_KEY=

# Optional. Web push stays off until the turn on phase sets this.
VITE_VAPID_PUBLIC_KEY=
